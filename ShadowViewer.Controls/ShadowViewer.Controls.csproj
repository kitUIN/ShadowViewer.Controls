<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>ShadowViewer.Controls</RootNamespace>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<EnableMsixTooling>true</EnableMsixTooling>
		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>
		<LangVersion>13</LangVersion>
		<Version>1.4.5</Version>
		<PackageId>ShadowViewer.Controls</PackageId>
		<Authors>kitUIN</Authors>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/kitUIN/ShadowViewer.Controls</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kitUIN/ShadowViewer.Controls</RepositoryUrl>
		<Description>✨ShadowViewer.Controls✨</Description>
		<Copyright>Copyright 2024-2026</Copyright>
		<PackageTags>kitUIN;wasdk;ShadowViewer;winui;Controls</PackageTags>
		<PackageOutputPath>..\..\..\NugetPackages</PackageOutputPath>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackControlResources</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Labs.WinUI.DependencyPropertyGenerator" Version="0.1.250319-build.2093" />
		<PackageReference Include="FluentIcons.WinUI" Version="1.1.292" />
		<PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.0.230907" />
	</ItemGroup>

	<Target Name="PackControlResources">
		<ItemGroup>
			<!-- WinUI embeds the compiled XAML in this PRI. Shipping loose XBF too causes duplicate resource keys. -->
			<TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).pri"
				PackagePath="lib\net8.0-windows10.0.19041" />
		</ItemGroup>
	</Target>
</Project>
